<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 11 o menor. El respaldo ya está desactivado con android:allowBackup="false" en el
   manifiesto; estas exclusiones son una segunda barrera por si alguien lo vuelve a activar.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
